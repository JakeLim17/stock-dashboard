# ──────────────────────────────────────────────────────────────
# 실시간 주식 대시보드 환경변수
# 모두 선택 사항. 비워두면 Yahoo Finance + Google News RSS만 사용.
# ──────────────────────────────────────────────────────────────

# (필수에 가깝게) 비밀번호 게이트 — /login 1회 입력 → 30일 쿠키 자동 통과
# 비워 두면 대시보드는 막힘. 로컬에서 비번 없이 쓰려면 아래 AUTH_DISABLED=1 을 명시.
DASHBOARD_PASS=

# (로컬 전용) 1 이면 비밀번호 없이 통과. Vercel/공개 배포에는 절대 넣지 말 것.
AUTH_DISABLED=

# 한국투자증권 KIS Open API (선택 — 없어도 대시보드 동작)
# 발급: https://apiportal.koreainvestment.com → Open API 신청 → 모의투자 키 추천
#
# ─── 기본 OFF (페이지 로드·폴링만으로 토큰 발급 0회) ───
#   키가 있어도 호출하지 않음. 켜려면 명시적으로:
#        KIS_ENABLED=1
#   끄기: KIS_ENABLED 비우기 / 0 / false  또는  KIS_DISABLED=1
#   OFF 시 라우팅:
#     국내 시세 = 네이버 → Yahoo
#     수급     = 네이버 → mock
#     해외·지수 = Yahoo
#   ON 시(KIS_ENABLED=1 이고 키 있음): 해외·지수·수급 등에 KIS (토큰 캐시 재사용)
#
# 실전: https://openapi.koreainvestment.com:9443
# 모의: https://openapivts.koreainvestment.com:29443
KIS_DISABLED=
# 켜려면 1. 비우면 키와 무관하게 REST·토큰 0회.
KIS_ENABLED=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# KIS 토큰 발급 1분당 1회(EGW00133) 차단 시 cooldown 시간 (ms). 기본 300000(5분).
# KIS는 토큰 신규 발급 시 카톡 알림(1일 1회 정책)을 보내므로 보수적으로 길게 두는 게 안전.
# 60초 등 짧게 두면 폴링 사이클 안에서 재시도가 폭주해 카톡 알림이 여러 번 오는 사고가 있었다.
KIS_TOKEN_COOLDOWN_MS=

# ──────────────────────────────────────────────────────────────
# Vercel KV / Upstash Redis — KIS 토큰을 인스턴스 간 공유하는 cross-instance 캐시
# ──────────────────────────────────────────────────────────────
# Vercel serverless 환경에서는 메모리/디스크 캐시가 lambda 인스턴스마다 휘발/격리되어
# cold start 마다 KIS 토큰을 신규 발급하게 된다 → 카톡 알림 폭주.
# Vercel KV(Upstash) 가 연결되면 모든 인스턴스가 같은 토큰을 공유해 24h 에 1회만 발급.
#
# 셋업: Vercel 대시보드 → Storage → Create Database → KV/Upstash 선택 → 프로젝트 Connect.
#       → 아래 변수가 자동 주입됨 → Redeploy 1회.
# 자세한 가이드: docs/KIS_TOKEN_SETUP.md
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (선택, 옛 변수명) Upstash 직접 연결 시 자동 주입되는 변수. 위 KV_* 가 우선.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────────────────────
# KIS WebSocket 실시간 (체결가만, Phase 1)
# ──────────────────────────────────────────────────────────────
# 활성화 시: /api/realtime/stream (SSE) → KIS WS H0STCNT0(체결가) 구독.
#           카드의 현재가만 즉시 갱신. 폴링(장중 90s)은 백업으로 유지.
# OFF (기본) 시: SSE 연결 전혀 없음, EventSource 생성 안 함 → 회귀 0.
#
# ⚠⚠ Vercel 에서 NEXT_PUBLIC_REALTIME_ENABLED=true 금지 권장.
#   SSE 는 Active CPU·Provisioned Memory 를 급격히 소모한다 (Hobby 한도 폭주 원인).
#   켜려면 Redeploy + KIS_WS_RELAY_URL 필수. relay 없이 true 면 운영 503 이지만
#   클라이언트 backoff 재시도로 호출량은 늘어남. 가장 안전: false + 폴링만.
NEXT_PUBLIC_REALTIME_ENABLED=false

# KIS WebSocket 엔드포인트. 비워두면 KIS_BASE_URL 의 openapivts 포함 여부로 자동 분기
# (실전 :21000 / 모의 :31000). 명시하려면 아래 둘 중 하나.
# 실전: wss://ops.koreainvestment.com:21000
# 모의: wss://ops.koreainvestment.com:31000
# 주의: Vercel 함수가 한국 외 리전이면 직접 연결이 1006 으로 즉시 끊김 → KIS_WS_RELAY_URL 사용.
KIS_WS_URL=wss://ops.koreainvestment.com:21000

# ──────────────────────────────────────────────────────────────
# KIS WebSocket Relay (한국 IP 호스트 우회)
# ──────────────────────────────────────────────────────────────
# 비워두면 /api/realtime/stream 이 Vercel 함수에서 직접 KIS WS 시도.
#   → Vercel 리전이 한국 외(sin1/hnd1 등)면 1006 으로 즉시 종료된다.
#
# relay 호스팅(Oracle Cloud Seoul / 라즈베리파이 / NAS 등) 후 https URL 을 여기 넣으면
# /api/realtime/stream 이 SSE proxy 로 동작 — 자세한 가이드는 `relay/README.md`.
KIS_WS_RELAY_URL=

# relay 와 공유하는 비밀(`x-relay-secret` 헤더로 전달).
# relay 의 RELAY_SHARED_SECRET 과 동일 값. `openssl rand -hex 32`.
KIS_WS_RELAY_SECRET=

# ──────────────────────────────────────────────────────────────
# Vercel Cron — 시간별 분석 재실행 (/api/cron/refresh-analysis)
# ──────────────────────────────────────────────────────────────
# Vercel 대시보드 → Settings → Environment Variables 에 동일 값 설정.
# Cron 호출 시 Authorization: Bearer ${CRON_SECRET} 헤더로 검증.
# 로컬 테스트: curl -H "Authorization: Bearer YOUR_SECRET" http://localhost:9700/api/cron/refresh-analysis
CRON_SECRET=

# ──────────────────────────────────────────────────────────────
# Vercel Active CPU 절감 — 권장 폴링 (ms). SSOT: lib/providers/kisCachePolicy.ts
# 미설정 시 코드 기본값. Vercel env 에 15s/30s 등 짧은 값이 남아 있으면 제거·갱신.
# 탭 비활성 시 클라이언트 폴링 정지. 수동 새로고침만 즉시 full.
# ⚠ 1초·수초 단위 POLL 은 Hobby Active CPU 폭주 — 절대 넣지 말 것.
NEXT_PUBLIC_POLL_INTERVAL_REGULAR_MS=90000          # 정규장 OPEN (권장 90s)
NEXT_PUBLIC_POLL_INTERVAL_EXTENDED_MS=180000       # 시간외/프리/애프터 (권장 3분)
NEXT_PUBLIC_POLL_INTERVAL_OVERSEAS_NIGHT_MS=180000  # 해외 GDR 야간 (권장 3분)
NEXT_PUBLIC_POLL_INTERVAL_OFF_HOURS_MS=300000       # 모두 마감 (권장 5분)
NEXT_PUBLIC_POLL_INTERVAL_KIS_REGULAR_MS=25000     # (legacy) 미사용 — 시장상태 폴링만 사용
NEXT_PUBLIC_POLL_INTERVAL_KIS_EXTENDED_MS=60000    # (legacy)
NEXT_PUBLIC_POLL_INTERVAL_KIS_OFF_HOURS_MS=300000  # (legacy)
NEXT_PUBLIC_FULL_SNAPSHOT_MIN_MS=900000            # full 예측 자동 간격 (권장 15분)
# 호가 패널은 현재 UI 미연결. 재연결 시 12s는 /api/intraday 폭주 위험.
NEXT_PUBLIC_POLL_INTERVAL_ASP_MS=12000             # 호가 탭 폴링 (기본 12s, UI 미사용)

# ──────────────────────────────────────────────────────────────
# OpenDART — 한국 공시 이벤트 알파 (유상증자·실적·지분·합병 등)
# ──────────────────────────────────────────────────────────────
# 발급: https://opendart.fss.or.kr → 인증키 신청 (무료)
# 비우면 공시 피처는 skip (예측은 뉴스·수급 등 기존 경로만 사용)
OPENDART_API_KEY=

# ──────────────────────────────────────────────────────────────
# SEC EDGAR — 미국 공시 (무료, API 키 불필요)
# ──────────────────────────────────────────────────────────────
# data.sec.gov 는 User-Agent 필수. 비우면 기본값(TickerDay/0.1 …) 사용.
# SEC_USER_AGENT=TickerDay/0.1 (your-email@example.com)
SEC_USER_AGENT=
